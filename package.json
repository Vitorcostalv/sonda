{
  "name": "sonda",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "deepmerge-ts": "8.0.2"
    }
  },
  "scripts": {
    "dev": "pnpm --filter @sonda/web dev",
    "dev:native": "node scripts/dev-native.mjs",
    "dev:all": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "pnpm --filter @sonda/db generate",
    "db:migrate": "pnpm --filter @sonda/db migrate",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "1.64.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.39.0",
    "typescript-eslint": "^8.46.0",
    "prettier": "^3.6.0",
    "turbo": "^2.5.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "tsx": "^4.20.0"
  }
}
